# =============================================================================
# AquaCivis - Variables de entorno (plantilla)
# =============================================================================
# 1. Copia este archivo a ".env" en la raiz del proyecto y reemplaza los valores por los reales.
# 2. Nunca subas el ".env" a Git (debe estar en .gitignore).
#    Solo se sube este ".env.example", que no contiene secretos.
# --- Django ------------------------------------------------------------------

# Clave para firmar sesiones, cookies y tokens. Si se filtra, se pueden
# falsificar sesiones. Este valor es solo para desarrollo; en producción genera
# una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-clave-solo-para-desarrollo

# Muestra páginas de error detalladas. En producción SIEMPRE debe ser False,
# porque expone código y configuración.
DEBUG=True

# Dominios desde los que Django acepta peticiones (separados por comas, sin
# espacios). En producción agrega tu dominio real.
ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes confiables para formularios POST (protección CSRF). Deben incluir
# http:// o https:// y el puerto si aplica. En producción usa tu URL con https.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# --- Base de datos: Supabase PostgreSQL --------------------------------------
# Los datos de conexión están en el panel de Supabase.

DB_NAME=postgres
DB_USER=TU_USUARIO
DB_PASSWORD=TU_PASSWORD
DB_HOST=TU_HOST_DE_SUPABASE
# 5432 es el puerto estándar; si usas el pooler de Supabase puede ser otro.
DB_PORT=5432


# --- Correo: Brevo SMTP ------------------------------------------------------
# Se usa para enviar correos de la plataforma (aprobación de cuentas,
# restablecimiento de contraseña, etc.).

EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# Login y clave SMTP generados en Brevo ("SMTP y API"). No son los de tu cuenta.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Remitente de los correos. Debe estar validado en Brevo, o se rechazarán
# o irán a spam.
DEFAULT_FROM_EMAIL= #correo@dominio.com

# --- Aplicación --------------------------------------------------------------
# URL pública base de AquaCivis, usada para armar los enlaces dentro de los
# correos. En producción: tu dominio con https, sin barra final.
AQUACIVIS_SITE_URL=http://127.0.0.1:8000 #en desarrollo dejar asi